APP_NAME=Traffic Monitoring System
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# AMap keys
# Backward-compatible old variable (used as fallback):
AMAP_API_KEY=eb9daa43cedc80f0df9368ef649f91c5
# JS API key (frontend map SDK):
AMAP_JS_API_KEY=eb9daa43cedc80f0df9368ef649f91c5
# Web service key (backend web service API):
AMAP_WEB_SERVICE_KEY=d065ac1646d067ce314de53567ba4a71
WEATHER_API_KEY=replace_with_real_weather_api_key

# Backend infra
DATABASE_URL=sqlite:///./traffic.db
DATABASE_PASSWORD=traffic_password
REDIS_URL=redis://127.0.0.1:6379/0

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://traffic_user:traffic_password@127.0.0.1:5432/traffic_db

# CORS
CORS_ALLOW_ORIGINS=*
